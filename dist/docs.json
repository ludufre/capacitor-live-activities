      "slug": "updateactivityoptions",
      "docs": "Options for updating an existing Live Activity",
      "tags": [
        {
          "text": "Configuration Types",
          "name": "category"
        },
        {
          "text": "Configuration for updating an active Live Activity with new data and optional alert notifications.",
          "name": "description"
        },
        {
          "text": "```typescript\r\nconst updateOptions: UpdateActivityOptions = {\r\n  activityId: \"activity-123\",\r\n  data: { progress: 0.75, status: \"In Progress\" },\r\n  alertConfiguration: {\r\n    title: \"Progress Update\",\r\n    body: \"Task is 75% complete\",\r\n    sound: \"default\"\r\n  }\r\n};\r\n```",
          "name": "example"
        }
      ],
