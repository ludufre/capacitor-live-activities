        {
          "text": "```typescript\r\nconst endOptions: EndActivityOptions = {\r\n  activityId: \"activity-123\",\r\n  data: { status: \"Completed\", finalResult: \"Success\" },\r\n  dismissalPolicy: \"immediate\"\r\n};\r\n```",
