          },
          {
            "name": "returns",
            "text": "Promise with a handle to remove the listener"
          }
        ],
        "docs": "Listen for APNs push token updates of Live Activities. Activities are\r\nrequested with `pushType: .token`, so ActivityKit emits a remote-update\r\ntoken for every started (or recovered) activity. Tokens arrive\r\nasynchronously after `startActivity` resolves and can rotate over the\r\nlifetime of an activity — register this listener before starting the\r\nactivity and forward the latest token to your server.",
        "complexTypes": [
          "ActivityPushTokenEvent",
          "PluginListenerHandle"
        ],
        "slug": "addlisteneractivitypushtoken-"
      },
