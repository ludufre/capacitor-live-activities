        {
          "name": "dismissalPolicy",
          "tags": [],
          "docs": "How the ended activity leaves the Lock Screen (optional).\r\n- 'default': the system keeps the ended activity for up to 4 hours\r\n- 'immediate': the activity is removed right away\r\n- 'after': the activity is removed at `dismissalDate` (capped by the\r\n  system at 4 hours after the activity ended)",
          "complexTypes": [],
          "type": "'default' | 'immediate' | 'after' | undefined"
        },
        {
          "name": "dismissalDate",
          "tags": [],
          "docs": "Unix timestamp in milliseconds for the 'after' dismissal policy\r\n(ignored for other policies; falls back to 'default' when missing)",
